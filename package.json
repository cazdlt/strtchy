{
	"name": "strtchy",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prod": "npm run build && DATABASE_URL=./data/prod/local.db vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:seed": "DATABASE_URL=./data/dev/local.db npx tsx scripts/init-db.ts",
		"db:migrate": "DATABASE_URL=./data/dev/local.db npx tsx scripts/migrate.ts",
		"db:seed:prod": "DATABASE_URL=./data/prod/local.db npx tsx scripts/init-db.ts",
		"db:migrate:prod": "DATABASE_URL=./data/prod/local.db npx tsx scripts/migrate.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.3",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^25.0.3",
		"autoprefixer": "^10.4.23",
		"drizzle-kit": "^0.31.8",
		"postcss": "^8.5.6",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"better-auth": "^1.4.10",
		"better-sqlite3": "^12.5.0",
		"dotenv": "^17.2.3",
		"drizzle-orm": "^0.45.1",
		"nanoid": "^5.1.6",
		"vite-plugin-pwa": "^1.2.0"
	}
}
