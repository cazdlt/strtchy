# SQLite database path (local dev: ./data/dev/local.db, prod container: /app/data/prod/local.db)
DATABASE_URL=./data/dev/local.db

# Public base URL used by BetterAuth for callbacks, cookies, and password reset links
BETTER_AUTH_URL=https://strtchy.zamoradelatorre.com

# Required in production (NODE_ENV=production throws if missing).
# Generate a strong random secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-in-production

# Transactional email via Brevo (post-launch: password reset & email verification)
BREVO_API_KEY=
BREVO_FROM_EMAIL=Strtchy <noreply@strtchy.app>

# Continuous SQLite replication to Backblaze B2 (S3-compatible) via Litestream
# Enable in Docker Compose with: docker compose --profile backup up -d
LITESTREAM_B2_BUCKET=
LITESTREAM_B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
LITESTREAM_B2_ACCESS_KEY_ID=
LITESTREAM_B2_SECRET_ACCESS_KEY=

# Cloudflare Tunnel token (zero open inbound ports on the VM)
# Enable in Docker Compose with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
